{
  "version": 2,
  "builds": [
    {
      "src": "ATRPAP/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "src/dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "VITE_MODE": "public"
  }
}
